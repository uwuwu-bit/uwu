--============================================================
-- LIBRERIA
--============================================================
local function refreshLibrary()
    for _,c in ipairs(LibScroll:GetChildren()) do
        if c:IsA("Frame") and c.Name~="XenoEmpty" then c:Destroy() end
    end
    LibEmpty.Visible=(#S.saved==0)
    local y=6
    for i,rec in ipairs(S.saved) do
        local row=Instance.new("Frame")
        row.Size=UDim2.new(1,-12,0,46); row.Position=UDim2.new(0,6,0,y)
        row.BackgroundColor3=C.panel2; row.BorderSizePixel=0; row.Parent=LibScroll; corner(row,6)
        newLabel(row,rec.name,UDim2.new(0.65,-10,0,20),UDim2.new(0,8,0,2),C.accent,Enum.Font.GothamBold,12)
        local evc=#rec.events
        newLabel(row,string.format("⏱%.1fs • %dfr • %deventi",rec.duration,#rec.frames,evc),
            UDim2.new(0.65,-10,0,16),UDim2.new(0,8,0,22),C.textDim,Enum.Font.Gotham,10)
        newBtn(row,"▶ Play",UDim2.new(0,55,0,30),UDim2.new(1,-130,0,8),C.success,function()
            S.playbackRec=rec
            PlaySelectedLabel.Text=rec.name
            switchTab("Playback")
            setStatus("Selezionata: "..rec.name,C.blue)
        end).TextSize=10
        newBtn(row,"🗑",UDim2.new(0,30,0,30),UDim2.new(1,-70,0,8),C.danger,function()
            table.remove(S.saved,i); refreshLibrary()
            setStatus("Registrazione eliminata",C.warning)
        end).TextSize=11
        y=y+52
    end
    LibScroll.CanvasSize=UDim2.new(0,0,0,y+10)
end

--============================================================
-- RECORDING
--============================================================
local function startRecording()
    if S.playing then return end
    S.recording=true; S.recFrames={}; S.recEvents={}
    S.recStartTime=os.clock(); S.lastRecTime=0
    S.lastJump=false; S.lastTool=nil
    SaveAfterRec.Visible=false
    BigRecBtn.Text="⏹  STOP RECORDING"
    BigRecBtn.BackgroundColor3=C.danger
    RecDot.BackgroundTransparency=0
    setStatus("🔴 Registrazione in corso...",C.danger)
    RecInfoLabel.Text="🔴 Registrando TUTTO (click, tasti, camera)"
end

local function stopRecording()
    S.recording=false
    BigRecBtn.Text="⏺  START RECORDING"
    BigRecBtn.BackgroundColor3=C.success
    RecDot.BackgroundTransparency=1
    local duration=#S.recFrames>0 and S.recFrames[#S.recFrames].t or 0
    if duration>0.5 then
        SaveAfterRec.Visible=true
        setStatus(string.format("✅ Finito (%.1fs, %d frame, %d eventi)",duration,#S.recFrames,#S.recEvents),C.success)
        RecInfoLabel.Text="✅ Pronta. Salvala nella libreria."
    else
        setStatus("Troppo corta",C.warning)
        RecInfoLabel.Text="Registrazione troppo corta"
    end
end

-- INPUT RECORDING
local function canRecord() return S.recording end

UserInputService.InputBegan:Connect(function(input,gpe)
    if not canRecord() or gpe then return end
    local now=os.clock()-S.recStartTime
    local t=input.UserInputType

    if S.recMouse and (t==Enum.UserInputType.MouseButton1 or t==Enum.UserInputType.MouseButton2 or t==Enum.UserInputType.MouseButton3) then
        local btn=tostring(t):gsub("Enum.UserInputType.","")
        table.insert(S.recEvents,{t=now,type="mouse",button=btn,isDown=true,x=input.Position.X,y=input.Position.Y})
    end
    if S.recKeys and t==Enum.UserInputType.Keyboard then
        table.insert(S.recEvents,{t=now,type="key",key=input.KeyCode.Name,isDown=true})
    end
end)

UserInputService.InputEnded:Connect(function(input)
    if not canRecord() then return end
    local now=os.clock()-S.recStartTime
    local t=input.UserInputType
    if S.recMouse and (t==Enum.UserInputType.MouseButton1 or t==Enum.UserInputType.MouseButton2 or t==Enum.UserInputType.MouseButton3) then
        local btn=tostring(t):gsub("Enum.UserInputType.","")
        table.insert(S.recEvents,{t=now,type="mouse",button=btn,isDown=false,x=input.Position.X,y=input.Position.Y})
    end
    if S.recKeys and t==Enum.UserInputType.Keyboard then
        table.insert(S.recEvents,{t=now,type="key",key=input.KeyCode.Name,isDown=false})
    end
end)

if S.recScroll then
    UserInputService.InputChanged:Connect(function(input)
        if not canRecord() then return end
        if input.UserInputType==Enum.UserInputType.MouseWheel then
            local now=os.clock()-S.recStartTime
            table.insert(S.recEvents,{t=now,type="scroll",amount=input.Position.Z})
        end
    end)
end

-- FRAME SAMPLING
local lastSample=0
RunService.Heartbeat:Connect(function()
    if not S.recording then return end
    local now=os.clock()-S.recStartTime
    if now-S.lastRecTime<1/S.recordRate then return end
    S.lastRecTime=now

    local root=getRoot()
    if not root then return end

    -- frame
    local frame={t=now, cf=root.CFrame}
    if S.recCam then
        pcall(function() frame.camCf=Camera.CFrame end)
    end
    table.insert(S.recFrames,frame)

    -- events
    local hum=getHum()
    local jumping=hum and (hum:GetState()==Enum.HumanoidStateType.Jumping or hum:GetState()==Enum.HumanoidStateType.Freefall)
    if S.recJumps then
        if jumping and not S.lastJump then
            table.insert(S.recEvents,{t=now,type="jump"})
        end
        S.lastJump=jumping
    end

    if S.recTools then
        local ch=LP.Character
        local tool=ch and ch:FindFirstChildOfClass("Tool")
        local toolName=tool and tool.Name or nil
        if toolName~=S.lastTool then
            table.insert(S.recEvents,{t=now,type="tool",name=toolName})
            S.lastTool=toolName
        end
    end

    -- UI
    if now-lastSample>0.1 then
        lastSample=now
        RecTimeLabel.Text=fmtTime(now)
        FrameVal.Text=tostring(#S.recFrames)
        local m,k,o=0,0,0
        for _,e in ipairs(S.recEvents) do
            if e.type=="mouse" then m=m+1
            elseif e.type=="key" then k=k+1
            else o=o+1 end
        end
        MouseVal.Text=tostring(m)
        KeyVal.Text=tostring(k)
        ToolVal.Text=tostring(o)
    end
end)

--============================================================
-- PLAYBACK
--============================================================
local PLAYBACK_SKIP_KEYS = {
    W=true,A=true,S=true,D=true,Space=true,
    LeftShift=true,LeftControl=true,
    Up=true,Down=true,Left=true,Right=true,
}

local function fireEvent(ev)
    if ev.type=="mouse" then
        local btn=Enum.UserInputType[ev.button]
        if btn then
            pcall(function()
                VIM:SendMouseButtonEvent(math.floor(ev.x),math.floor(ev.y),btn,ev.isDown,game,0)
            end)
        end
    elseif ev.type=="key" then
        if not PLAYBACK_SKIP_KEYS[ev.key] then
            local kc=Enum.KeyCode[ev.key]
            if kc then
                pcall(function()
                    VIM:SendKeyEvent(ev.isDown,kc,false,game)
                end)
            end
        end
    elseif ev.type=="scroll" then
        pcall(function()
            VIM:SendMouseWheelEvent(0,0,ev.amount,game,0)
        end)
    elseif ev.type=="tool" then
        local ch=LP.Character; local bp=LP:FindFirstChild("Backpack")
        if ch and bp then
            local hum=ch:FindFirstChildOfClass("Humanoid")
            local current=ch:FindFirstChildOfClass("Tool")
            if ev.name then
                local target=bp:FindFirstChild(ev.name) or ch:FindFirstChild(ev.name)
                if target and hum and (not current or current.Name~=ev.name) then
                    pcall(function() hum:EquipTool(target) end)
                end
            else
                if current and hum then pcall(function() hum:UnequipTools() end) end
            end
        end
    elseif ev.type=="jump" then
        -- handled via CFrame, skip
    end
end

local function startPlayback()
    if S.playing or not S.playbackRec then return end
    if #S.playbackRec.frames==0 then setStatus("Registrazione vuota",C.warning); return end
    S.playing=true
    S.playbackStart=os.clock()
    S.playbackIdx=1
    S.playbackEvtIdx=1
    S.totalRuns=0
    -- Camera Scriptable per playback fluido
    if S.recCam and S.playbackRec.frames[1] and S.playbackRec.frames[1].camCf then
        pcall(function()
            S.camOldType = Camera.CameraType
            Camera.CameraType = Enum.CameraType.Scriptable
        end)
    end
    setStatus("▶ Playback: "..S.playbackRec.name,C.success)
    PlaybackStatus.Text="▶ Playing "..S.playbackRec.name
    PlayPlayBtn.BackgroundColor3=C.warning
    PlayPlayBtn.Text="⏸ STOP (playing)"
end

local function stopPlayback(resetStatus)
    S.playing=false
    PlayPlayBtn.Text="▶  PLAY"
    PlayPlayBtn.BackgroundColor3=C.success
    if resetStatus~=false then setStatus("Playback fermato",C.warning) end
    PlaybackStatus.Text="Status: idle"
    ProgFill.Size=UDim2.new(0,0,1,0)
    ProgLabel.Text="0:00.00 / 0:00.00"
    -- restore camera
    if S.camOldType then
        pcall(function() Camera.CameraType = S.camOldType end)
        S.camOldType = nil
    end
end

RunService.Heartbeat:Connect(function()
    if not S.playing or not S.playbackRec then return end
    local rec=S.playbackRec
    local elapsed=(os.clock()-S.playbackStart)*S.speed

    -- fire events
    while S.playbackEvtIdx<=#rec.events do
        local ev=rec.events[S.playbackEvtIdx]
        if ev.t>elapsed then break end
        fireEvent(ev)
        S.playbackEvtIdx=S.playbackEvtIdx+1
    end

    -- interpolate position
    local frames=rec.frames
    while S.playbackIdx<#frames and frames[S.playbackIdx+1].t<=elapsed do
        S.playbackIdx=S.playbackIdx+1
    end

    local root=getRoot()
    if root and S.playbackIdx<=#frames then
        local f1=frames[S.playbackIdx]
        local f2=frames[math.min(S.playbackIdx+1,#frames)]
        local alpha=1
        if S.playbackIdx<#frames then
            alpha=math.clamp((elapsed-f1.t)/math.max(0.001,f2.t-f1.t),0,1)
        end
        pcall(function() root.CFrame=f1.cf:Lerp(f2.cf,alpha) end)

        -- camera
        if S.recCam and f1.camCf and f2.camCf then
            pcall(function()
                Camera.CFrame=f1.camCf:Lerp(f2.camCf,alpha)
            end)
        end
    end

    if os.clock()-S.lastProgressUpdate>0.05 then
        S.lastProgressUpdate=os.clock()
        local pct=math.clamp(elapsed/math.max(0.001,rec.duration),0,1)
        ProgFill.Size=UDim2.new(pct,0,1,0)
        ProgLabel.Text=fmtTime(math.min(elapsed,rec.duration)).." / "..fmtTime(rec.duration)
    end

    if elapsed>=rec.duration then
        if S.loop then
            S.playbackStart=os.clock()
            S.playbackIdx=1; S.playbackEvtIdx=1
            S.totalRuns=S.totalRuns+1
            LoopCountLabel.Text="Esecuzioni: "..S.totalRuns
        else
            S.totalRuns=S.totalRuns+1
            LoopCountLabel.Text="Esecuzioni: "..S.totalRuns
            stopPlayback()
            setStatus("✅ Playback completato",C.success)
        end
    end
end)

--============================================================
-- SAVE
--============================================================
local function saveRecordingToLibrary()
    if #S.recFrames<2 then setStatus("Nessuna registrazione",C.warning); return end
    local name="rec_"..os.date("%H%M%S")
    local duration=S.recFrames[#S.recFrames].t
    table.insert(S.saved,{name=name,frames=S.recFrames,events=S.recEvents,duration=duration})
    refreshLibrary()
    setStatus("✅ Salvata: "..name,C.success)
    RecInfoLabel.Text="✅ Salvata come "..name
    SaveAfterRec.Visible=false
    if writefile then
        pcall(function()
            if makefolder and not (isfolder and isfolder("xeno_recorder")) then makefolder("xeno_recorder") end
            local data={name=name,duration=duration,events={},frames={}}
            for _,e in ipairs(S.recEvents) do table.insert(data.events,e) end
            for _,f in ipairs(S.recFrames) do
                local fc={t=f.t,cf={f.cf:GetComponents()}}
                if f.camCf then fc.camCf={f.camCf:GetComponents()} end
                table.insert(data.frames,fc)
            end
            writefile("xeno_recorder/"..name..".json",HttpService:JSONEncode(data))
        end)
    end
end

SaveAfterRec.MouseButton1Click:Connect(saveRecordingToLibrary)

SaveAllBtn.MouseButton1Click:Connect(function()
    if #S.saved==0 then setStatus("Libreria vuota",C.warning); return end
    local out={}
    for _,rec in ipairs(S.saved) do
        local data={name=rec.name,duration=rec.duration,frames={},events=rec.events}
        for _,f in ipairs(rec.frames) do
            local fc={t=f.t,cf={f.cf:GetComponents()}}
            if f.camCf then fc.camCf={f.camCf:GetComponents()} end
            table.insert(data.frames,fc)
        end
        table.insert(out,data)
    end
    local json=HttpService:JSONEncode(out)
    print("[XenoRecorder] Export:")
    print(json)
    if setclipboard then pcall(setclipboard,json); setStatus("✅ Console + clipboard",C.success)
    else setStatus("✅ Console (F9)",C.success) end
end)

ClearAllBtn.MouseButton1Click:Connect(function()
    S.saved={}; refreshLibrary(); setStatus("Libreria svuotata",C.warning)
end)

--============================================================
-- BUTTONS
--============================================================
BigRecBtn.MouseButton1Click:Connect(function()
    if S.recording then stopRecording() else startRecording() end
end)
PlayPlayBtn.MouseButton1Click:Connect(function()
    if S.playing then stopPlayback() else startPlayback() end
end)
PlayStopBtn.MouseButton1Click:Connect(function() stopPlayback() end)

--============================================================
-- HOTKEYS
--============================================================
UserInputService.InputBegan:Connect(function(inp,gpe)
    if gpe then return end
    if inp.KeyCode==Enum.KeyCode.F1 then
        if S.recording then stopRecording() else startRecording() end
    elseif inp.KeyCode==Enum.KeyCode.F2 then
        if S.playing then stopPlayback() else startPlayback() end
    elseif inp.KeyCode==Enum.KeyCode.F3 then
        if not S.recording and #S.recFrames>1 then saveRecordingToLibrary() end
    end
end)

LP.CharacterAdded:Connect(function()
    if S.recording then
        local now=os.clock()-S.recStartTime
        table.insert(S.recEvents,{t=now,type="respawn"})
    end
end)

switchTab("Record")
refreshLibrary()
setStatus("✅ Pronto — F1 registra, F2 play, F3 salva",C.success)
print("[XenoRecorder v2] Pronto. F1=record F2=play F3=save")
