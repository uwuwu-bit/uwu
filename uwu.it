local ToggleData={
    {"📍 Posizione", "recPos", true},
    {"🎥 Camera",   "recCam", true},
    {"🖱 Mouse",     "recMouse", true},
    {"⌨ Tastiera",  "recKeys", true},
    {"🔧 Tool",      "recTools", true},
    {"🦘 Salti",     "recJumps", true},
    {"🖲 Scroll",    "recScroll", true},
}

local ToggleBtns={}
for i,td in ipairs(ToggleData) do
    local idx=i-1
    local col=idx%2; local row=math.floor(idx/2)
    local b=Instance.new("TextButton")
    b.Size=UDim2.new(0.5,-3,0,20)
    b.Position=UDim2.new(col*0.5+0.002,row*22+16,0,0)
    b.BackgroundColor3=td[3] and C.success or C.panel2
    b.Text=(td[3] and "☑ " or "☐ ")..td[1]
    b.TextColor3=C.text; b.Font=Enum.Font.Gotham; b.TextSize=10
    b.TextXAlignment=Enum.TextXAlignment.Left; b.AutoButtonColor=false
    b.Parent=ToggleFrame; corner(b,4)
    S[td[2]]=td[3]
    b.MouseButton1Click:Connect(function()
        S[td[2]]=not S[td[2]]
        b.Text=(S[td[2]] and "☑ " or "☐ ")..td[1]
        b.BackgroundColor3=S[td[2]] and C.success or C.panel2
    end)
    ToggleBtns[td[2]]=b
end

