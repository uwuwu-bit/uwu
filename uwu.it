--============================================================
-- ROBLOX RECORDER - Registra e riproduci azioni
-- Executor: Xeno
-- Features: record, playback (con speed/loop), libreria, salvataggio
--============================================================

local Players          = game:GetService("Players")
local RunService       = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local CoreGui          = game:GetService("CoreGui")
local HttpService      = game:GetService("HttpService")
local TweenService     = game:GetService("TweenService")
local LP               = Players.LocalPlayer

--============================================================
-- COLORI
--============================================================
local C = {
    bg      = Color3.fromRGB(20, 20, 28),
    panel   = Color3.fromRGB(30, 30, 42),
    panel2  = Color3.fromRGB(40, 40, 54),
    border  = Color3.fromRGB(60, 60, 80),
    accent  = Color3.fromRGB(255, 140, 0),
    accent2 = Color3.fromRGB(255, 180, 60),
    text    = Color3.fromRGB(230, 230, 240),
    textDim = Color3.fromRGB(150, 150, 170),
    success = Color3.fromRGB(80, 210, 120),
    danger  = Color3.fromRGB(230, 80, 80),
    warning = Color3.fromRGB(250, 190, 70),
    blue    = Color3.fromRGB(80, 150, 250),
}

--============================================================
-- STATO
--============================================================
local S = {
    recording = false,
    playing = false,
    recFrames = {},
    recEvents = {},
    recStartTime = 0,
    lastRecTime = 0,
    lastJump = false,
    lastTool = nil,
    recordRate = 20,
    playbackStart = 0,
    playbackIdx = 1,
    playbackEvtIdx = 1,
    playbackRec = nil,
    speed = 1.0,
    loop = false,
    loopCount = 0,
    totalRuns = 0,
    saved = {},
    lastProgressUpdate = 0,
}

--============================================================
-- UTILS
--============================================================
local function corner(p, r) local c = Instance.new("UICorner", p); c.CornerRadius = UDim.new(0, r or 6); return c end
local function stroke(p, col, t) local s = Instance.new("UIStroke", p); s.Color = col or C.border; s.Thickness = t or 1; return s end

local function getRoot()
    local ch = LP.Character
    return ch and ch:FindFirstChild("HumanoidRootPart")
end
local function getHum()
    local ch = LP.Character
    return ch and ch:FindFirstChildOfClass("Humanoid")
end
local function fmtTime(t)
    local m = math.floor(t / 60)
    local s = t - m * 60
    return string.format("%d:%05.2f", m, s)
end
local function newBtn(parent, text, size, pos, color, cb)
    local b = Instance.new("TextButton")
    b.Size, b.Position = size, pos
    b.BackgroundColor3 = color or C.panel2
    b.Text = text
    b.TextColor3 = C.text
    b.Font = Enum.Font.GothamBold
    b.TextSize = 12
    b.AutoButtonColor = false
    b.Parent = parent
    corner(b, 6)
    if cb then
        b.MouseButton1Click:Connect(cb)
        b.MouseEnter:Connect(function() TweenService:Create(b, TweenInfo.new(0.15), {BackgroundColor3 = color and color:Lerp(Color3.new(1,1,1), 0.15) or C.panel2}):Play() end)
        b.MouseLeave:Connect(function() TweenService:Create(b, TweenInfo.new(0.15), {BackgroundColor3 = color or C.panel2}):Play() end)
    end
    return b
end
local function newLabel(parent, text, size, pos, color, font, ts)
    local l = Instance.new("TextLabel")
    l.Size, l.Position = size, pos
    l.BackgroundTransparency = 1
    l.Text = text
    l.TextColor3 = color or C.text
    l.Font = font or Enum.Font.Gotham
    l.TextSize = ts or 12
    l.TextXAlignment = Enum.TextXAlignment.Left
    l.Parent = parent
    return l
end

