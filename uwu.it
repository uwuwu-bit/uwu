local TabData = {
    {name="Record", icon="⏺"},
    {name="Playback", icon="▶"},
    {name="Library", icon="📚"},
}
local TabBtns = {}
local TabContents = {}

local function switchTab(name)
    for _, b in ipairs(TabBtns) do
        if b.Name == name then
            b.BackgroundColor3 = C.panel2
            b.TextColor3 = C.accent
        else
            b.BackgroundColor3 = C.panel
            b.TextColor3 = C.textDim
        end
    end
    for _, f in ipairs(TabContents) do f.Visible = (f.Name == name) end
end

for i, td in ipairs(TabData) do
    local b = Instance.new("TextButton")
    b.Name = td.name
    b.Size = UDim2.new(1/#TabData, -4, 1, -6)
    b.Position = UDim2.new((i-1)/#TabData, 2, 0, 3)
    b.BackgroundColor3 = C.panel
    b.Text = td.icon.." "..td.name
    b.TextColor3 = C.textDim
    b.Font = Enum.Font.GothamBold
    b.TextSize = 11
    b.AutoButtonColor = false
    b.Parent = TabsBar
    corner(b, 5)
    b.MouseButton1Click:Connect(function() switchTab(td.name) end)
    table.insert(TabBtns, b)
end

