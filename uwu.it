local function statBox(parent,x,y,w,label,color)
    newLabel(parent,label,UDim2.new(w,-8,0,14),UDim2.new(x+6,y,0,0),C.textDim,Enum.Font.Gotham,10)
    local v=newLabel(parent,"0",UDim2.new(w,-8,0,20),UDim2.new(x+6,y+14,0,0),color or C.text,Enum.Font.GothamBold,15)
    return v
end

