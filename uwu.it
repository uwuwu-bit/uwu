-- TABS
local TabsBar=Instance.new("Frame")
TabsBar.Size=UDim2.new(1,-20,0,32); TabsBar.Position=UDim2.new(0,10,0,50)
TabsBar.BackgroundColor3=C.panel; TabsBar.BorderSizePixel=0; TabsBar.Parent=Main
corner(TabsBar,6)

local TabData={{name="Record",icon="⏺"},{name="Playback",icon="▶"},{name="Library",icon="📚"},{name="Settings",icon="⚙"}}
local TabBtns={}
local TabContents={}

local function switchTab(name)
    for _,b in ipairs(TabBtns) do
        if b.Name==name then b.BackgroundColor3=C.panel2; b.TextColor3=C.accent
        else b.BackgroundColor3=C.panel; b.TextColor3=C.textDim end
    end
    for _,f in ipairs(TabContents) do f.Visible=(f.Name==name) end
end

for i,td in ipairs(TabData) do
    local b=Instance.new("TextButton")
    b.Name=td.name
    b.Size=UDim2.new(1/#TabData,-4,1,-6); b.Position=UDim2.new((i-1)/#TabData,2,0,3)
    b.BackgroundColor3=C.panel; b.Text=td.icon.." "..td.name
    b.TextColor3=C.textDim; b.Font=Enum.Font.GothamBold; b.TextSize=11
    b.AutoButtonColor=false; b.Parent=TabsBar
    corner(b,5)
    b.MouseButton1Click:Connect(function() switchTab(td.name) end)
    table.insert(TabBtns,b)
end

local Content=Instance.new("Frame")
Content.Size=UDim2.new(1,-20,1,-170); Content.Position=UDim2.new(0,10,0,88)
Content.BackgroundTransparency=1; Content.Parent=Main

for _,td in ipairs(TabData) do
    local f=Instance.new("Frame")
    f.Name=td.name; f.Size=UDim2.new(1,0,1,0); f.BackgroundTransparency=1
    f.Visible=false; f.Parent=Content
    table.insert(TabContents,f)
end

