camPlaybackInfo.TextWrapped=true
newLabel(SetTab,"Hotkeys:\nF1 = start/stop record\nF2 = start/stop playback\nF3 = salva in libreria (se registrazione pronta)",UDim2.new(1,0,0,60),UDim2.new(0,0,0,150),C.textDim,Enum.Font.Gotham,10).TextWrapped=true

