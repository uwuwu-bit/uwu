newLabel(SetTab,"Rate di campionamento (frame/secondo):",UDim2.new(1,0,0,16),UDim2.new(0,0,0,28),C.textDim,Enum.Font.Gotham,11)
local RateVal=newLabel(SetTab,"20 Hz",UDim2.new(0,60,0,16),UDim2.new(1,-60,0,28),C.accent,Enum.Font.GothamBold,12)
RateVal.TextXAlignment=Enum.TextXAlignment.Right
local RateSlider=Instance.new("Frame")
RateSlider.Size=UDim2.new(1,0,0,20); RateSlider.Position=UDim2.new(0,0,0,48)
RateSlider.BackgroundColor3=C.panel; RateSlider.BorderSizePixel=0; RateSlider.Parent=SetTab; corner(RateSlider,10)
local RateFill=Instance.new("Frame")
RateFill.Size=UDim2.new((20-5)/(60-5),0,1,0); RateFill.BackgroundColor3=C.accent
RateFill.BorderSizePixel=0; RateFill.Parent=RateSlider; corner(RateFill,10)
local RateKnob=Instance.new("Frame")
RateKnob.Size=UDim2.new(0,16,0,16); RateKnob.Position=UDim2.new((20-5)/(60-5),-8,0,2)
RateKnob.BackgroundColor3=C.accent2; RateKnob.BorderSizePixel=0; RateKnob.Parent=RateSlider
corner(RateKnob,8); stroke(RateKnob,C.bg,2)
local function setRate(v)
    v=math.clamp(v,5,60)
    S.recordRate=math.floor(v)
    local t=(v-5)/(60-5)
    TweenService:Create(RateFill,TweenInfo.new(0.1),{Size=UDim2.new(t,0,1,0)}):Play()
    TweenService:Create(RateKnob,TweenInfo.new(0.1),{Position=UDim2.new(t,-8,0,2)}):Play()
    RateVal.Text=S.recordRate.." Hz"
end
local rateDrag=false
RateSlider.InputBegan:Connect(function(inp)
    if inp.UserInputType==Enum.UserInputType.MouseButton1 or inp.UserInputType==Enum.UserInputType.Touch then
        rateDrag=true
        local rel=(inp.Position.X-RateSlider.AbsolutePosition.X)/RateSlider.AbsoluteSize.X
        setRate(5+math.clamp(rel,0,1)*(60-5))
    end
end)
UserInputService.InputChanged:Connect(function(inp)
    if rateDrag and (inp.UserInputType==Enum.UserInputType.MouseMovement or inp.UserInputType==Enum.UserInputType.Touch) then
        local rel=(inp.Position.X-RateSlider.AbsolutePosition.X)/RateSlider.AbsoluteSize.X
        setRate(5+math.clamp(rel,0,1)*(60-5))
    end
end)
UserInputService.InputEnded:Connect(function(inp)
    if inp.UserInputType==Enum.UserInputType.MouseButton1 or inp.UserInputType==Enum.UserInputType.Touch then rateDrag=false end
end)

newLabel(SetTab,"Playback:",UDim2.new(1,0,0,16),UDim2.new(0,0,0,90),C.textDim,Enum.Font.GothamBold,11)
