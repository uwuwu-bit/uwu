--============================================================
-- LIBRERIA: UI RENDER
--============================================================
local function refreshLibrary()
    for _, c in ipairs(LibScroll:GetChildren()) do
        if c:IsA("Frame") and c.Name ~= "XenoEmpty" then c:Destroy() end
    end
    LibEmpty.Visible = #S.saved == 0

    local y = 6
    for i, rec in ipairs(S.saved) do
        local row = Instance.new("Frame")
        row.Size = UDim2.new(1, -12, 0, 42)
        row.Position = UDim2.new(0, 6, 0, y)
        row.BackgroundColor3 = C.panel2
        row.BorderSizePixel = 0
        row.Parent = LibScroll
        corner(row, 6)

        newLabel(row, rec.name, UDim2.new(0.6, -10, 0, 20), UDim2.new(0, 8, 0, 2), C.accent, Enum.Font.GothamBold, 13)
        newLabel(row, string.format("⏱ %.1fs  •  %d frame", rec.duration, #rec.frames),
            UDim2.new(0.6, -10, 0, 16), UDim2.new(0, 8, 0, 22), C.textDim, Enum.Font.Gotham, 10)

        local loadBtn = newBtn(row, "▶ Play", UDim2.new(0, 60, 0, 28), UDim2.new(1, -140, 0, 7), C.success, function()
            S.playbackRec = rec
            PlaySelectedLabel.Text = rec.name
            switchTab("Playback")
            setStatus("Selezionata: "..rec.name, C.blue)
        end)
        loadBtn.TextSize = 11

        local delBtn = newBtn(row, "🗑", UDim2.new(0, 32, 0, 28), UDim2.new(1, -72, 0, 7), C.danger, function()
            table.remove(S.saved, i)
            refreshLibrary()
            setStatus("Registrazione eliminata", C.warning)
        end)
        delBtn.TextSize = 12

        y = y + 48
    end
    LibScroll.CanvasSize = UDim2.new(0, 0, 0, y + 10)
end

--============================================================
-- RECORDING LOGIC
--============================================================
local function startRecording()
    if S.playing then return end
    S.recording = true
    S.recFrames = {}
    S.recEvents = {}
    S.recStartTime = os.clock()
    S.lastRecTime = 0
    S.lastJump = false
    S.lastTool = nil
    SaveAfterRec.Visible = false
    BigRecBtn.Text = "⏹  STOP RECORDING"
    BigRecBtn.BackgroundColor3 = C.danger
    RecDot.BackgroundTransparency = 0
    setStatus("Registrazione in corso...", C.danger)
    RecInfoLabel.Text = "🔴 Registrando... muoviti e usa i tool"
end

local function stopRecording()
    S.recording = false
    BigRecBtn.Text = "⏺  START RECORDING"
    BigRecBtn.BackgroundColor3 = C.success
    RecDot.BackgroundTransparency = 1
    local duration = #S.recFrames > 0 and S.recFrames[#S.recFrames].t or 0
    if duration > 0.5 then
        SaveAfterRec.Visible = true
        setStatus(string.format("Registrazione finita (%.1fs, %d frame) → salva", duration, #S.recFrames), C.success)
        RecInfoLabel.Text = "✅ Registrazione pronta. Salvala nella libreria."
    else
        setStatus("Registrazione troppo corta", C.warning)
        RecInfoLabel.Text = "Registrazione troppo corta, riprova."
    end
    FramesVal.Text = tostring(#S.recFrames)
    EventsVal.Text = tostring(#S.recEvents)
end

-- Sample loop
local lastSample = 0
RunService.Heartbeat:Connect(function()
    if not S.recording then return end
    local now = os.clock() - S.recStartTime
    if now - S.lastRecTime < 1/S.recordRate then return end
    S.lastRecTime = now

    local root = getRoot()
    local hum = getHum()
    if not root then return end

    local cf = root.CFrame
    local jumping = hum and (hum:GetState() == Enum.HumanoidStateType.Jumping or hum:GetState() == Enum.HumanoidStateType.Freefall) and hum.Jump == true
    local ch = LP.Character
    local tool = ch and ch:FindFirstChildOfClass("Tool")
    local toolName = tool and tool.Name or nil

    if jumping and not S.lastJump then
        table.insert(S.recEvents, {t=now, type="jump"})
    end
    S.lastJump = jumping

    if toolName ~= S.lastTool then
        table.insert(S.recEvents, {t=now, type="tool", name=toolName})
        S.lastTool = toolName
    end

    table.insert(S.recFrames, {t=now, cf=cf})

    -- Update UI once per ~0.1s
    if now - lastSample > 0.1 then
        lastSample = now
        RecTimeLabel.Text = fmtTime(now)
        FramesVal.Text = tostring(#S.recFrames)
        EventsVal.Text = tostring(#S.recEvents)
        local bytes = #S.recFrames * 100 -- rough estimate
        SizeVal.Text = string.format("%.1f KB", bytes / 1024)
    end
end)

--============================================================
-- PLAYBACK LOGIC
--============================================================
local function startPlayback()
    if S.playing or not S.playbackRec then return end
    if #S.playbackRec.frames == 0 then setStatus("Registrazione vuota", C.warning); return end
    S.playing = true
    S.playbackStart = os.clock()
    S.playbackIdx = 1
    S.playbackEvtIdx = 1
    S.loopCount = 0
    setStatus("Playback avviato: "..S.playbackRec.name, C.success)
    PlaybackStatus.Text = "▶ Playing "..S.playbackRec.name
    PlayPlayBtn.BackgroundColor3 = C.warning
    PlayPlayBtn.Text = "⏸ PAUSA"
end

local function stopPlayback(resetStatus)
    S.playing = false
    PlayPlayBtn.Text = "▶  PLAY"
    PlayPlayBtn.BackgroundColor3 = C.success
    if resetStatus ~= false then
        setStatus("Playback fermato", C.warning)
    end
    PlaybackStatus.Text = "Status: idle"
    ProgFill.Size = UDim2.new(0, 0, 1, 0)
    ProgLabel.Text = "0:00.00 / 0:00.00"
end

RunService.Heartbeat:Connect(function()
    if not S.playing or not S.playbackRec then return end
    local rec = S.playbackRec
    local elapsed = (os.clock() - S.playbackStart) * S.speed

    -- FIRE EVENTS
    while S.playbackEvtIdx <= #rec.events do
        local ev = rec.events[S.playbackEvtIdx]
        if ev.t > elapsed then break end
        if ev.type == "jump" then
            local hum = getHum()
            if hum then hum.Jump = true end
        elseif ev.type == "tool" then
            local ch = LP.Character
            local bp = LP:FindFirstChild("Backpack")
            if ch and bp then
                local hum = ch:FindFirstChildOfClass("Humanoid")
                local current = ch:FindFirstChildOfClass("Tool")
                if ev.name then
                    local target = bp:FindFirstChild(ev.name) or ch:FindFirstChild(ev.name)
                    if target and hum and (not current or current.Name ~= ev.name) then
                        hum:EquipTool(target)
                    end
                else
                    if current then hum:UnequipTools() end
                end
            end
        end
        S.playbackEvtIdx = S.playbackEvtIdx + 1
    end

    -- INTERPOLATE POSITION
    local frames = rec.frames
    while S.playbackIdx < #frames and frames[S.playbackIdx + 1].t <= elapsed do
        S.playbackIdx = S.playbackIdx + 1
    end

    local root = getRoot()
    if root then
        if S.playbackIdx < #frames then
            local f1 = frames[S.playbackIdx]
            local f2 = frames[S.playbackIdx + 1]
            local alpha = (elapsed - f1.t) / math.max(0.001, f2.t - f1.t)
            alpha = math.clamp(alpha, 0, 1)
            root.CFrame = f1.cf:Lerp(f2.cf, alpha)
        else
            root.CFrame = frames[S.playbackIdx].cf
        end
    end

    -- UPDATE PROGRESS
    if os.clock() - S.lastProgressUpdate > 0.05 then
        S.lastProgressUpdate = os.clock()
        local pct = math.clamp(elapsed / math.max(0.001, rec.duration), 0, 1)
        ProgFill.Size = UDim2.new(pct, 0, 1, 0)
        ProgLabel.Text = fmtTime(math.min(elapsed, rec.duration)).." / "..fmtTime(rec.duration)
    end

    -- END
    if elapsed >= rec.duration then
        if S.loop then
            S.playbackStart = os.clock()
            S.playbackIdx = 1
            S.playbackEvtIdx = 1
            S.loopCount = S.loopCount + 1
            S.totalRuns = S.totalRuns + 1
            LoopCountLabel.Text = "Esecuzioni: "..S.totalRuns
        else
            S.totalRuns = S.totalRuns + 1
            LoopCountLabel.Text = "Esecuzioni: "..S.totalRuns
            stopPlayback()
            setStatus("Playback completato", C.success)
        end
    end
end)

--============================================================
-- SAVE / EXPORT
--============================================================
local function saveRecordingToLibrary()
    if #S.recFrames < 2 then setStatus("Nessuna registrazione", C.warning); return end
    local name = "rec_"..os.date("%H%M%S")
    local duration = S.recFrames[#S.recFrames].t
    table.insert(S.saved, {
        name = name,
        frames = S.recFrames,
        events = S.recEvents,
        duration = duration,
    })
    refreshLibrary()
    setStatus("✅ Salvata: "..name, C.success)
    RecInfoLabel.Text = "✅ Salvata come "..name
    SaveAfterRec.Visible = false

    -- Try to persist via writefile
    if writefile then
        pcall(function()
            if not (isfolder and isfolder("xeno_recorder")) then
                if makefolder then makefolder("xeno_recorder") end
            end
            local data = {name=name, duration=duration, events={}, frames={}}
            for _, f in ipairs(S.recEvents) do table.insert(data.events, f) end
            for _, f in ipairs(S.recFrames) do
                table.insert(data.frames, {t=f.t, cf={f.cf:GetComponents()}})
            end
            writefile("xeno_recorder/"..name..".json", HttpService:JSONEncode(data))
        end)
    end
end

SaveAfterRec.MouseButton1Click:Connect(saveRecordingToLibrary)

SaveAllBtn.MouseButton1Click:Connect(function()
    if #S.saved == 0 then setStatus("Libreria vuota", C.warning); return end
    local out = {}
    for _, rec in ipairs(S.saved) do
        local data = {name=rec.name, duration=rec.duration, frames={}, events=rec.events}
        for _, f in ipairs(rec.frames) do
            table.insert(data.frames, {t=f.t, cf={f.cf:GetComponents()}})
        end
        table.insert(out, data)
    end
    local json = HttpService:JSONEncode(out)
    print("[XenoRecorder] Export registrazioni:")
    print(json)
    if setclipboard then
        pcall(setclipboard, json)
        setStatus("✅ Esportato in console + clipboard", C.success)
    else
        setStatus("✅ Esportato in console (F9)", C.success)
    end
end)

ClearAllBtn.MouseButton1Click:Connect(function()
    S.saved = {}
    refreshLibrary()
    setStatus("Libreria svuotata", C.warning)
end)

--============================================================
-- BUTTONS
--============================================================
BigRecBtn.MouseButton1Click:Connect(function()
    if S.recording then stopRecording() else startRecording() end
end)

PlayPlayBtn.MouseButton1Click:Connect(function()
    if S.playing then stopPlayback() else startPlayback() end
end)
PlayStopBtn.MouseButton1Click:Connect(function() stopPlayback() end)

--============================================================
-- HOTKEYS (F1 = record toggle, F2 = play toggle)
--============================================================
UserInputService.InputBegan:Connect(function(inp, gpe)
    if gpe then return end
    if inp.KeyCode == Enum.KeyCode.F1 then
        if S.recording then stopRecording() else startRecording() end
    elseif inp.KeyCode == Enum.KeyCode.F2 then
        if S.playing then stopPlayback() else startPlayback() end
    end
end)

--============================================================
-- RESPAWN HANDLER
--============================================================
LP.CharacterAdded:Connect(function()
    if S.recording then
        local now = os.clock() - S.recStartTime
        table.insert(S.recEvents, {t=now, type="respawn"})
    end
end)

--============================================================
-- INIT
--============================================================
switchTab("Record")
refreshLibrary()
setStatus("✅ Pronto — premi F1 o il pulsante per registrare", C.success)
print("[XenoRecorder] Caricato. F1=record, F2=play.")
